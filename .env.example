# ---------------------------------------------------------------------------
# Krabi Flight Radar — environment configuration
# Copy to .env and adjust. Never commit real credentials.
# ---------------------------------------------------------------------------

# PostgreSQL connection (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/krabi_flight_radar
# Separate database used by the server integration tests
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/krabi_flight_radar_test

# HTTP server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Seed reference data (airports, default profile, origin access profiles) on
# startup when the database is empty.
AUTO_SEED=true

# ---------------------------------------------------------------------------
# Flight search providers
# Comma separated list of enabled providers. "mock" needs no credentials and
# is fully functional for local development and automated tests.
# Options: mock, duffel, amadeus
# ---------------------------------------------------------------------------
FLIGHT_PROVIDERS=mock

# Duffel (https://duffel.com) — server side only, never exposed to the browser
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_VERSION=v2
DUFFEL_BASE_URL=https://api.duffel.com

# Amadeus — the Self-Service portal was decommissioned in July 2026. The adapter
# targets the same REST endpoints, which now require Amadeus Enterprise API
# credentials (commercial contract). Leave empty unless you have those.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://api.amadeus.com

# Provider throttling (applies to every provider)
PROVIDER_MAX_CONCURRENCY=3
PROVIDER_MIN_INTERVAL_MS=250
PROVIDER_CACHE_TTL_MINUTES=30
# Upper bound of live validation searches per search run (Stage B)
SEARCH_MAX_VALIDATION_CANDIDATES=48
# Re-price the top N ranked journeys with their provider before presenting them (0 = off)
SEARCH_REPRICE_TOP_N=3

# ---------------------------------------------------------------------------
# Booking-flow price verification (asynchronous, after every search)
# A driver walks the selling channel's booking process up to the payment page
# (never through it) and records the final price. Browser drivers use a
# headless Chromium via Playwright; API channels use their pricing endpoint.
# ---------------------------------------------------------------------------
VERIFY_ENABLED=true
# Verify the top N ranked journeys of each search run automatically
VERIFY_TOP_N=3
VERIFY_CONCURRENCY=1
# Reuse a verification of the same flights done within this many minutes instead of walking the flow again
VERIFY_CACHE_MINUTES=60
# Where screenshots of each booking step are stored (default packages/server/data/verifications)
VERIFY_DATA_DIR=
# Chromium executable for Playwright; leave empty to use the browser installed by `npx playwright install chromium`
PLAYWRIGHT_CHROMIUM_PATH=
# URL under which this server reaches itself (needed by browser drivers for locally hosted flows)
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Background scheduling
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_HOURS=6

# Notification provider: log | none
NOTIFICATION_PROVIDER=log
