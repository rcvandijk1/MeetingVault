<UserControl x:Class="MeetingVault.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Meeting History" Style="{StaticResource HeaderText}"
                   Grid.Row="0" Grid.ColumnSpan="2"/>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,12" LastChildFill="False">
            <TextBox Width="220" DockPanel.Dock="Left" Margin="0,0,8,0"
                     Text="{Binding SubjectFilter, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Width="120" DockPanel.Dock="Left" Margin="0,0,8,0"
                     Text="{Binding PlatformFilter, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Filter" Command="{Binding RefreshAsyncCommand}"/>
            <Button Content="Refresh" Command="{Binding RefreshAsyncCommand}" DockPanel.Dock="Right"/>
        </DockPanel>

        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <ListBox ItemsSource="{Binding Meetings}" SelectedItem="{Binding Selected}"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Subject}" FontWeight="SemiBold"/>
                            <TextBlock>
                                <Run Text="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding Platform}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding Status}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding Selected}">
                    <TextBlock Text="{Binding Subject}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Margin="0,4,0,12"/>

                    <TextBlock Text="Subject"/>
                    <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

                    <TextBlock Text="Platform"/>
                    <TextBox Text="{Binding Platform, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

                    <TextBlock Text="Organizer"/>
                    <TextBox Text="{Binding Organizer, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>

                    <TextBlock Text="Notes"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80" Margin="0,2,0,8"/>

                    <TextBlock Text="Folder"/>
                    <TextBox Text="{Binding FolderPath, Mode=OneWay}" IsReadOnly="True" Margin="0,2,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open Folder"
                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Open Transcript"
                                Command="{Binding DataContext.OpenTranscriptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Run / Re-run Transcription"
                                Command="{Binding DataContext.RunTranscriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Review Speakers"
                                Command="{Binding DataContext.ReviewSpeakersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                        <Button Content="Save Metadata" Style="{StaticResource PrimaryButton}"
                                Command="{Binding DataContext.SaveMetadataCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
