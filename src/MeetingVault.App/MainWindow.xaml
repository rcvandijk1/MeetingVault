<Window x:Class="MeetingVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MeetingVault.App.ViewModels"
        xmlns:views="clr-namespace:MeetingVault.App.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="MeetingVault" Height="780" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SpeakerReviewViewModel}">
            <views:SpeakerReviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#181A20" Padding="16">
            <StackPanel>
                <TextBlock Text="MeetingVault" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                <Button Content="Dashboard" HorizontalContentAlignment="Left" Padding="12,10"
                        Margin="0,0,0,4" Background="Transparent" BorderThickness="0"
                        Command="{Binding ShowDashboardCommand}"/>
                <Button Content="History" HorizontalContentAlignment="Left" Padding="12,10"
                        Margin="0,0,0,4" Background="Transparent" BorderThickness="0"
                        Command="{Binding ShowHistoryCommand}"/>
                <Button Content="Speaker Review" HorizontalContentAlignment="Left" Padding="12,10"
                        Margin="0,0,0,4" Background="Transparent" BorderThickness="0"
                        Command="{Binding ShowSpeakerReviewCommand}"/>
                <Button Content="Search" HorizontalContentAlignment="Left" Padding="12,10"
                        Margin="0,0,0,4" Background="Transparent" BorderThickness="0"
                        Command="{Binding ShowSearchCommand}"/>
                <Button Content="Settings" HorizontalContentAlignment="Left" Padding="12,10"
                        Margin="0,0,0,4" Background="Transparent" BorderThickness="0"
                        Command="{Binding ShowSettingsCommand}"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="MeetingVault"
                        Visibility="Visible"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open MeetingVault" Click="OpenApp_Click"/>
                    <Separator/>
                    <MenuItem Header="Start recording" Click="TrayStart_Click"/>
                    <MenuItem Header="Stop recording" Click="TrayStop_Click"/>
                    <Separator/>
                    <MenuItem Header="Open output folder" Click="OpenFolder_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
