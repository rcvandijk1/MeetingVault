{
  "name": "kantlijn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome-extensie die beïnvloedingstechnieken in nieuwsartikelen zichtbaar maakt.",
  "scripts": {
    "test": "node --test tests/*.test.js && node scripts/sync-manifest.mjs --check",
    "test:e2e": "node tests/e2e.mjs",
    "sync": "node scripts/sync-manifest.mjs",
    "feeds": "node scripts/check-feeds.mjs",
    "vendor": "esbuild scripts/vendor-entry.mjs --bundle --format=esm --platform=browser --minify --legal-comments=inline --outfile=vendor/anthropic-sdk.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "esbuild": "^0.28.2"
  }
}
